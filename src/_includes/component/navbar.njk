<style>
  /* Premium Dynamic Navbar CSS */
  .re-navbar {
    display: grid;
    grid-template-columns: 1fr 180px 1fr;
    align-items: center;
    padding: 0.5rem 5%;
    background-color: #2370ba;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    z-index: 1000;
    transition: padding 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease, box-shadow 0.4s ease, grid-template-columns 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .re-navbar.scrolled {
    padding: 0.35rem 5%;
    grid-template-columns: 1fr 100px 1fr;
    background-color: #2370ba;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
  }

  .re-logo-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    justify-self: center;
    position: relative;
  }

  .re-logo-link::before {
    display: none;
  }

  .re-navbar.scrolled .re-logo-link::before {
    display: none;
  }

  .re-logo-img {
    height: 110px;
    width: auto;
    transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateY(0);
    position: relative;
    z-index: 2;
  }

  .re-navbar.scrolled .re-logo-img {
    height: 60px;
    transform: translateY(0);
    filter: none;
  }

  .re-logo-text {
    display: none;
  }

  .re-nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .left-links {
    justify-self: end;
    padding-right: 30px;
  }

  .right-links {
    justify-self: start;
    padding-left: 30px;
  }

  .re-nav-links a {
    text-decoration: none;
    color: #ffffff;
    font-weight: 500;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
  }

  .re-nav-links a:hover {
    color: #38bdf8;
  }

  .re-nav-contact {
    padding: 8px 20px;
    background-color: #ffffff;
    color: #2370ba !important;
    border-radius: 4px;
    font-weight: 700 !important;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .re-nav-contact:hover {
    background-color: #f1f5f9;
    color: #1d5f9e !important;
  }

  /* Premium Animated Hamburger Menu Styles */
  .mobile-toggle-btn {
    display: none;
    background: transparent !important;
    border: none !important;
    width: 28px;
    height: 20px;
    position: relative;
    cursor: pointer;
    padding: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    -webkit-tap-highlight-color: transparent !important;
  }

  .mobile-toggle-btn span {
    display: block;
    position: absolute;
    height: 2.5px;
    width: 100%;
    background: #ffffff;
    border-radius: 4px;
    opacity: 1;
    left: 0;
    transform: rotate(0deg);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-toggle-btn span:nth-child(1) {
    top: 0px;
  }

  .mobile-toggle-btn span:nth-child(2),
  .mobile-toggle-btn span:nth-child(3) {
    top: 8px;
  }

  .mobile-toggle-btn span:nth-child(4) {
    top: 16px;
  }

  /* Active state transitions */
  .mobile-toggle-btn.active span:nth-child(1) {
    top: 8px;
    width: 0%;
    left: 50%;
    opacity: 0;
  }

  .mobile-toggle-btn.active span:nth-child(2) {
    transform: rotate(45deg);
  }

  .mobile-toggle-btn.active span:nth-child(3) {
    transform: rotate(-45deg);
  }

  .mobile-toggle-btn.active span:nth-child(4) {
    top: 8px;
    width: 0%;
    left: 50%;
    opacity: 0;
  }

  .mobile-nav-dropdown {
    display: none;
    flex-direction: column;
    background-color: #2370ba;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 999;
    padding: 0 5%;
    gap: 0;
    box-shadow: 0 15px 30px rgba(15, 23, 42, 0.15);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, padding 0.3s ease;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }

  .mobile-nav-dropdown::-webkit-scrollbar {
    width: 6px;
  }

  .mobile-nav-dropdown::-webkit-scrollbar-track {
    background: transparent;
  }

  .mobile-nav-dropdown::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
  }

  .mobile-nav-dropdown.active {
    max-height: calc(100vh - 100%);
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
    opacity: 1;
    padding: 1.4rem 5% 1.8rem 5%;
    pointer-events: auto;
    gap: 0.2rem;
  }

  .mobile-nav-dropdown a {
    text-decoration: none;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: block;
    transition: color 0.25s ease;
  }

  .mobile-nav-dropdown a:last-child {
    border-bottom: none;
  }

  .mobile-nav-dropdown a:hover {
    color: #38bdf8;
  }

  .mobile-nav-dropdown a.mobile-contact-btn {
    background: #ffffff;
    color: #2370ba !important;
    text-align: center;
    border-radius: 6px;
    font-weight: 800;
    padding: 0.9rem;
    border: none;
    margin-top: 0.8rem;
    display: block;
  }

  @media (max-width: 1024px) {
    .re-navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 5%;
    }

    .re-nav-links {
      display: none;
    }

    .mobile-toggle-btn {
      display: block;
    }

    .re-logo-link {
      flex-direction: row;
      gap: 10px;
    }

    .re-logo-link::before {
      display: none !important;
    }

    .re-logo-img {
      display: block !important;
      height: 55px !important;
      transform: none !important;
    }

    .re-navbar.scrolled .re-logo-img {
      display: block !important;
      height: 55px !important;
      transform: none !important;
      filter: none !important;
    }

    .re-logo-text {
      display: none !important;
    }

    .mobile-nav-dropdown {
      display: flex;
    }
  }


</style>

<nav class="re-navbar" aria-label="Main Navigation">
  
  <ul class="re-nav-links left-links" role="menubar">
    <li role="none"><a href="/#home" role="menuitem">Home</a></li>
    <li role="none"><a href="/search/" role="menuitem">Properties</a></li>
    <li role="none"><a href="/#featured-communities" role="menuitem">Communities</a></li>
    <li role="none"><a href="/#services" role="menuitem">Services</a></li>
  </ul>

  <a href="/#home" class="re-logo-link">
    <h1 class="re-logo-text">Murtaza <span>Homes</span></h1>
    <img src="/assets/murtaza-brand.JPG" alt="Murtaza Homes Logo" class="re-logo-img" width="213" height="110">
  </a>

  <ul class="re-nav-links right-links" role="menubar">
    <li role="none"><a href="/blog/" role="menuitem">Blog</a></li>
    <li role="none"><a href="/#faq" role="menuitem">FAQ</a></li>
    <li role="none"><a href="/#about-agent" role="menuitem">About</a></li>
    <li role="none"><a href="/#contact" role="menuitem" class="re-nav-contact">Contact</a></li>
  </ul>

  <button class="mobile-toggle-btn" aria-label="Toggle navigation menu" id="mobile-toggle">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </button>

  <!-- Mobile Dropdown Drawer -->
  <div class="mobile-nav-dropdown" id="mobile-dropdown">
    <a href="/#home">Home</a>
    <a href="/search/">Properties</a>
    <a href="/#featured-communities">Communities</a>
    <a href="/#services">Services</a>
    <a href="/blog/">Blog</a>
    <a href="/#faq">FAQ</a>
    <a href="/#about-agent">About</a>
    <a href="/#contact" class="mobile-contact-btn">Contact Murtaza</a>
  </div>

</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.querySelector('.re-navbar');
    const mobileToggle = document.getElementById('mobile-toggle');
    const mobileDropdown = document.getElementById('mobile-dropdown');

    if (navbar) {
      const handleScroll = () => {
        if (window.scrollY > 5) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      };
      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll(); // Run once on load
    }

    if (mobileToggle && mobileDropdown) {
      mobileToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = mobileDropdown.classList.contains('active');
        if (isOpen) {
          mobileDropdown.classList.remove('active');
          mobileToggle.classList.remove('active');
        } else {
          mobileDropdown.classList.add('active');
          mobileToggle.classList.add('active');
        }
      });

      // Close dropdown when clicking a link
      mobileDropdown.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileDropdown.classList.remove('active');
          mobileToggle.classList.remove('active');
        });
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!mobileDropdown.contains(e.target) && !mobileToggle.contains(e.target)) {
          mobileDropdown.classList.remove('active');
          mobileToggle.classList.remove('active');
        }
      });
    }

    /* Smooth anchor scrolling with navbar offset */
    document.querySelectorAll('a[href*="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const href = this.getAttribute('href');
        const hashIndex = href.indexOf('#');
        if (hashIndex === -1) return;
        const targetId = href.substring(hashIndex);
        if (targetId === '#') return;
        
        const pathPart = href.substring(0, hashIndex);
        const isCurrentPage = pathPart === '' || pathPart === '/' || window.location.pathname === pathPart || (window.location.pathname === '/index.html' && pathPart === '/');
        
        if (isCurrentPage) {
          const targetEl = document.querySelector(targetId);
          if (targetEl) {
            e.preventDefault();
            history.pushState(null, null, targetId);
            const navHeight = navbar ? navbar.offsetHeight : 80;
            const targetPos = targetEl.getBoundingClientRect().top + window.pageYOffset - navHeight - 20;
            window.scrollTo({
              top: targetPos,
              behavior: 'smooth'
            });
          }
        }
      });
    });
  });
</script>
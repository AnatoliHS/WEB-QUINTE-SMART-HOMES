<style>
  /* Premium Dynamic Navbar CSS */
  .re-navbar {
    display: grid;
    grid-template-columns: 1fr 180px 1fr;
    align-items: center;
    padding: 1rem 5%;
    background-color: #2370ba;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    z-index: 1000;
    transition: padding 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease, box-shadow 0.4s ease, grid-template-columns 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .re-navbar.scrolled {
    padding: 0.75rem 5%;
    grid-template-columns: 1fr 100px 1fr;
    background-color: #2370ba;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
  }

  .re-logo-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    justify-self: center;
    position: relative;
  }

  .re-logo-link::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    width: 160px;
    height: 160px;
    background-color: #2370ba;
    border-radius: 50%;
    z-index: 1;
    opacity: 1;
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease;
    pointer-events: none;
  }

  .re-navbar.scrolled .re-logo-link::before {
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }

  .re-logo-img {
    height: 100px;
    width: auto;
    transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateY(0);
    position: relative;
    z-index: 2;
  }

  .re-navbar.scrolled .re-logo-img {
    height: 50px;
    transform: translateY(0);
    filter: none;
  }

  .re-logo-text {
    display: none;
  }

  .re-nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .left-links {
    justify-self: end;
    padding-right: 30px;
  }

  .right-links {
    justify-self: start;
    padding-left: 30px;
  }

  .re-nav-links a {
    text-decoration: none;
    color: #ffffff;
    font-weight: 500;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
  }

  .re-nav-links a:hover {
    color: #38bdf8;
  }

  .re-nav-contact {
    padding: 8px 20px;
    background-color: #ffffff;
    color: #2370ba !important;
    border-radius: 4px;
    font-weight: 700 !important;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .re-nav-contact:hover {
    background-color: #f1f5f9;
    color: #1d5f9e !important;
  }

  /* Clean Hamburger Menu Styles (No White Glow) */
  .mobile-toggle-btn {
    display: none;
    background: transparent !important;
    border: none !important;
    color: #ffffff !important;
    font-size: 2.2rem;
    cursor: pointer;
    padding: 0.5rem 0.6rem;
    outline: none !important;
    box-shadow: none !important;
    line-height: 1;
    -webkit-tap-highlight-color: transparent !important;
  }

  .mobile-toggle-btn:focus,
  .mobile-toggle-btn:active,
  .mobile-toggle-btn:hover {
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }

  .mobile-nav-dropdown {
    display: none;
    flex-direction: column;
    background-color: #2370ba;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    /* In document flow directly below the sticky navbar — no fixed positioning */
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 998;
    padding: 0 5%;
    gap: 0;
    box-shadow: 0 15px 30px rgba(15, 23, 42, 0.15);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.3s ease;
  }

  .mobile-nav-dropdown.active {
    max-height: 600px;
    overflow: visible;
    opacity: 1;
    padding: 1.4rem 5% 1.8rem 5%;
    pointer-events: auto;
    gap: 0.2rem;
  }

  .mobile-nav-dropdown a {
    text-decoration: none;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: block;
    transition: color 0.25s ease;
  }

  .mobile-nav-dropdown a:last-child {
    border-bottom: none;
  }

  .mobile-nav-dropdown a:hover {
    color: #38bdf8;
  }

  .mobile-nav-dropdown a.mobile-contact-btn {
    background: #ffffff;
    color: #2370ba !important;
    text-align: center;
    border-radius: 6px;
    font-weight: 800;
    padding: 0.9rem;
    border: none;
    margin-top: 0.8rem;
    display: block;
  }

  @media (max-width: 1024px) {
    .re-navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 5%;
    }

    .re-nav-links {
      display: none;
    }

    .mobile-toggle-btn {
      display: block;
    }

    .re-logo-link {
      flex-direction: row;
      gap: 10px;
    }

    .re-logo-link::before {
      display: none !important;
    }

    .re-logo-img {
      display: block !important;
      height: 38px !important;
      transform: none !important;
    }

    .re-navbar.scrolled .re-logo-img {
      display: block !important;
      height: 38px !important;
      transform: none !important;
      filter: none !important;
    }

    .re-logo-text {
      display: block !important;
      font-size: 1.2rem;
      font-weight: 700;
      color: #ffffff;
      margin: 0;
      font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
      /* Always visible on mobile — override the scrolled fade-out */
      opacity: 1 !important;
      max-height: 50px !important;
      transform: translateY(0) !important;
      pointer-events: auto !important;
    }

    .re-logo-text span {
      font-weight: 300;
      color: rgba(255, 255, 255, 0.7);
    }

    .mobile-nav-dropdown {
      display: flex;
    }
  }


</style>

<nav class="re-navbar" aria-label="Main Navigation">
  
  <ul class="re-nav-links left-links" role="menubar">
    <li role="none"><a href="/#home" role="menuitem">Home</a></li>
    <li role="none"><a href="/search/" role="menuitem">Properties</a></li>
    <li role="none"><a href="/#featured-communities" role="menuitem">Communities</a></li>
    <li role="none"><a href="/#services" role="menuitem">Services</a></li>
  </ul>

  <a href="/#home" class="re-logo-link">
    <h1 class="re-logo-text">Murtaza <span>Homes</span></h1>
    <img src="/assets/remax.png" alt="RE/MAX Logo" class="re-logo-img">
  </a>

  <ul class="re-nav-links right-links" role="menubar">
    <li role="none"><a href="/blog/" role="menuitem">Blog</a></li>
    <li role="none"><a href="/#faq" role="menuitem">FAQ</a></li>
    <li role="none"><a href="/#about-agent" role="menuitem">About</a></li>
    <li role="none"><a href="/#contact" role="menuitem" class="re-nav-contact">Contact</a></li>
  </ul>

  <button class="mobile-toggle-btn" aria-label="Toggle navigation menu" id="mobile-toggle">
    ☰
  </button>

</nav>

<!-- Mobile Dropdown Drawer -->
<div class="mobile-nav-dropdown" id="mobile-dropdown">
  <a href="/#home">Home</a>
  <a href="/search/">Properties</a>
  <a href="/#featured-communities">Communities</a>
  <a href="/#services">Services</a>
  <a href="/blog/">Blog</a>
  <a href="/#faq">FAQ</a>
  <a href="/#about-agent">About</a>
  <a href="/#contact" class="mobile-contact-btn">Contact Murtaza</a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.querySelector('.re-navbar');
    const mobileToggle = document.getElementById('mobile-toggle');
    const mobileDropdown = document.getElementById('mobile-dropdown');

    if (navbar) {
      const handleScroll = () => {
        if (window.scrollY > 5) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      };
      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll(); // Run once on load
    }

    if (mobileToggle && mobileDropdown) {
      mobileToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = mobileDropdown.classList.contains('active');
        if (isOpen) {
          mobileDropdown.classList.remove('active');
          mobileToggle.innerHTML = '☰';
        } else {
          mobileDropdown.classList.add('active');
          mobileToggle.innerHTML = '✕';
        }
      });

      // Close dropdown when clicking a link
      mobileDropdown.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileDropdown.classList.remove('active');
          mobileToggle.innerHTML = '☰';
        });
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!navbar.contains(e.target) && !mobileDropdown.contains(e.target)) {
          mobileDropdown.classList.remove('active');
          mobileToggle.innerHTML = '☰';
        }
      });
    }

    /* Smooth anchor scrolling with navbar offset */
    document.querySelectorAll('a[href*="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const href = this.getAttribute('href');
        const hashIndex = href.indexOf('#');
        if (hashIndex === -1) return;
        const targetId = href.substring(hashIndex);
        if (targetId === '#') return;
        
        const pathPart = href.substring(0, hashIndex);
        const isCurrentPage = pathPart === '' || pathPart === '/' || window.location.pathname === pathPart || (window.location.pathname === '/index.html' && pathPart === '/');
        
        if (isCurrentPage) {
          const targetEl = document.querySelector(targetId);
          if (targetEl) {
            e.preventDefault();
            history.pushState(null, null, targetId);
            const navHeight = navbar ? navbar.offsetHeight : 80;
            const targetPos = targetEl.getBoundingClientRect().top + window.pageYOffset - navHeight - 20;
            window.scrollTo({
              top: targetPos,
              behavior: 'smooth'
            });
          }
        }
      });
    });
  });
</script>
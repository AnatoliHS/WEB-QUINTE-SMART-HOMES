<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} — {{ site.title }}</title>
    <meta name="description" content="{{ summary or site.description }}" />

    <!-- startr.style: layout and spacing come from inline --prop attributes,
         so there is no stylesheet of your own to write or maintain. -->
    <link rel="stylesheet" href="/startr.css" />
    <style>
      .google-preferred-badge {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 99999;
        display: inline-flex;
        align-items: center;
        gap: 0;
        height: 48px;
        width: 48px;
        max-width: 48px;
        padding: 0;
        justify-content: center;
        background-color: #ffffff;
        color: #202124;
        border: 1px solid #dadce0;
        border-radius: 24px;
        text-decoration: none;
        font-family: var(--font-body, system-ui, -apple-system, sans-serif);
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
        transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                    padding 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                    gap 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                    background-color 0.2s ease,
                    box-shadow 0.2s ease;
        overflow: hidden;
        white-space: nowrap;
      }

      .google-preferred-badge .google-preferred-icon {
        flex-shrink: 0;
        width: 22px;
        height: 22px;
        fill: #4285f4;
        color: #4285f4;
      }

      .google-preferred-badge .google-preferred-text {
        opacity: 0;
        max-width: 0;
        overflow: hidden;
        transition: opacity 0.25s ease, max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
      }

      .google-preferred-badge:hover,
      .google-preferred-badge:focus-visible {
        max-width: 260px;
        width: auto;
        padding: 0 18px 0 14px;
        gap: 10px;
        background-color: #ffffff;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
      }

      .google-preferred-badge:hover .google-preferred-text,
      .google-preferred-badge:focus-visible .google-preferred-text {
        opacity: 1;
        max-width: 200px;
      }

      @media (max-width: 768px) {
        .google-preferred-badge {
          bottom: 16px;
          right: 16px;
          max-width: 280px;
          width: auto;
          padding: 0 16px 0 12px;
          gap: 8px;
          background-color: #ffffff;
          box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
        }

        .google-preferred-badge .google-preferred-text {
          opacity: 1;
          max-width: 200px;
        }
      }
    </style>

    <!-- Startr Swap: same-origin links swap in place instead of reloading.
         Delete this one line and every link navigates normally. -->
    <script defer src="/js/startr-swap.js"></script>
  </head>

  <body style="--maxw:70ch; --m:0 auto; --p:1rem; --p-md:2rem">
    <header style="--mb:2rem">
      <a href="/" style="--size:1.25rem"><strong>{{ site.title }}</strong></a>

      <nav style="--d:flex; --g:1rem; --mt:0.5rem">
        {% for item in site.nav %}
          <a href="{{ item.href }}">{{ item.title }}</a>
        {% endfor %}
      </nav>
    </header>

    <!-- Everything inside data-swap is what Startr Swap replaces. Anything
         outside it — the header above, the footer below — survives untouched. -->
    <main data-swap>
      <h1>{{ title }}</h1>
      {% if date %}<p><small>{{ date | readableDate }}</small></p>{% endif %}
      {{ content | safe }}
    </main>

    <footer style="--mt:3rem; --size:0.875rem">
      <p>{{ site.title }} — built with Eleventy, startr.style, and Startr Swap.</p>
      <div style="margin-top: 1rem;">
        {% include "component/preferred-badge.njk" %}
      </div>
    </footer>
  </body>
</html>

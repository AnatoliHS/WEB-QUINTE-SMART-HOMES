---
layout: default.njk
---

<style>
    /* Premium Blog Post Styling */
    .blog-post-header {
        text-align: center;
        margin-bottom: 3rem;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        padding: 4rem 5% 3rem 5%;
        border-bottom: 1px solid rgba(15, 23, 42, 0.05);
    }

    .blog-post-category {
        display: inline-block;
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--color-primary);
        margin-bottom: 1rem;
    }

    .blog-post-title {
        font-size: 2.8rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
        margin: 0 0 1.25rem 0;
        font-family: var(--font-heading);
    }

    .blog-post-meta {
        font-size: 0.95rem;
        color: #64748b;
        font-weight: 500;
    }

    .blog-post-container {
        max-width: 800px;
        margin: 0 auto 6rem auto;
        padding: 0 1.5rem;
    }

    .blog-content {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #334155;
    }

    .blog-content h2 {
        font-size: 1.8rem;
        font-weight: 800;
        color: #0f172a;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-family: var(--font-heading);
    }

    .blog-content h3 {
        font-size: 1.4rem;
        font-weight: 700;
        color: #0f172a;
        margin-top: 2rem;
        margin-bottom: 0.8rem;
        font-family: var(--font-heading);
    }

    .blog-content p {
        margin-bottom: 1.5rem;
    }

    .blog-content ul, .blog-content ol {
        margin-bottom: 1.75rem;
        padding-left: 1.75rem;
    }

    .blog-content li {
        margin-bottom: 0.6rem;
    }

    .back-to-blog {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-primary);
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 2rem;
    }

    .back-to-blog:hover {
        text-decoration: underline;
    }
</style>

<div class="blog-post-header">
    <div class="blog-post-category">Smart Automation Insights</div>
    <h1 class="blog-post-title">{{ title }}</h1>
    <div class="blog-post-meta">
        Published by <strong>Quinte Smart Homes Team</strong>
        {% if date %} • {{ date | postDate }}{% endif %}
    </div>
</div>

<div class="blog-post-container">
    <a href="/blog/" class="back-to-blog">&larr; Back to News & Insights</a>
    <article class="blog-content">
        {{ content | safe }}
    </article>
</div>
